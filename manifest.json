{
  "manifest_version": 3,
  "name": "RelayContext",
  "version": "1.0.0",
  "description": "Intelligent context transfer for AI workflows.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/context-engine.js",
        "content/platforms/platform-detector.js",
        "content/platforms/chatgpt.js",
        "content/platforms/claude.js",
        "content/platforms/gemini.js",
        "content/platforms/copilot.js",
        "content/platforms/grok.js",
        "content/scraper.js"
      ]
    }
  ]
}
