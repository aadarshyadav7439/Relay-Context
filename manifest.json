{
  "manifest_version": 3,
  "name": "RelayContext",
  "version": "1.0.0",
  "description": "Intelligent context transfer for AI workflows.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "popup/icons/relay.png",
      "48": "popup/icons/relay.png",
      "128": "popup/icons/relay.png"
    }
  },
  "icons": {
    "16": "popup/icons/relay.png",
    "48": "popup/icons/relay.png",
    "128": "popup/icons/relay.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://*.copilot.microsoft.com/*",
    "*://copilot.microsoft.com/*",
    "*://grok.com/*",
    "*://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://*.copilot.microsoft.com/*",
        "*://copilot.microsoft.com/*",
        "*://grok.com/*",
        "*://api.anthropic.com/*"
      ],
      "js": [
        "content/context-engine.js",
        "content/platforms/platform-detector.js",
        "content/platforms/chatgpt.js",
        "content/platforms/claude.js",
        "content/platforms/gemini.js",
        "content/platforms/copilot.js",
        "content/platforms/grok.js",
        "content/scraper.js",
        "content/injector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
